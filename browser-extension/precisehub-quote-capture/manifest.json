{
  "manifest_version": 3,
  "name": "PreciseHub Quote Capture",
  "version": "0.1.4",
  "description": "Capture a reviewed travel quote and its listing link into an open PreciseHub booking.",
  "action": {
    "default_title": "Capture PreciseHub quote",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://cards-project-kappa.vercel.app/*",
    "https://precisehub-git-main-precise-hub.vercel.app/*"
  ]
}
